# FastAPI 后端配置
# 复制为 .env 并填入真实值（.env 不入版本控制）

# ---- 运行环境 ----
ENVIRONMENT=dev
DEBUG=true

# ---- 数据库 ----
# 本地开发用 SQLite；CloudBase 生产强制使用 MySQL + PyMySQL。
# ENVIRONMENT=prod 时若仍是 SQLite，服务会拒绝启动，避免把正式数据写进临时容器。
DATABASE_BACKEND=sqlalchemy
DATABASE_URL=sqlite:///./dev.db
# CloudBase 面板复制的 mysql:// 会自动选用已安装的 PyMySQL 驱动。
# DATABASE_URL=mysql://USER:URL_ENCODED_PASSWORD@INTERNAL_HOST:3306/DATABASE?charset=utf8mb4

# CloudBase MySQL HTTPS REST 迁移完成后才改为 cloudbase_rest。
# Server API Key 只放云托管服务端环境变量，不是微信 AppSecret，也不能进入前端。
# 云托管“API Key 设置”会自动注入 CLOUDBASE_APIKEY，无需手填明文。
# 下面变量只用于本地验证或未使用平台自动注入时的显式兼容。
CLOUDBASE_DB_API_KEY=
CLOUDBASE_DB_TIMEOUT_SECONDS=5
CLOUDBASE_DB_READ_RETRIES=1

# ---- JWT ----
# 必填：独立强随机值（≥32 字节），不是微信 AppSecret 也不是数据库密码。
# 本地生成：openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=10080

# ---- 微信小程序 ----
# 必填：到 https://mp.weixin.qq.com 注册小程序后获取
WX_APPID=
# 当前正式登录链路不读取 WX_SECRET；仅旧 code2session 兼容模式才需要。
WX_SECRET=
CLOUDBASE_ENV_ID=
# CloudBase 私有链路登录默认不需要 AppSecret；仅旧 code2session 兼容模式才开启。
ENABLE_CODE2SESSION=false

# ---- 容器 ----
PORT=8080

# ---- 和风天气 ----
# https://dev.qweather.com/ 注册开发者版 key（免费 1000 次/天）
HEFENG_KEY=
HEFENG_API=https://devapi.qweather.com/v7/weather/now
HEFENG_GEO_API=https://geoapi.qweather.com/v2/city/lookup

# ---- Open-Meteo（T09 实际使用，免 key 免注册）----
# 默认公共 API host。如自建可改此 var。
OPEN_METEO_API=https://api.open-meteo.com/v1/forecast

# ---- 高德地图（逆地理，可选）----
AMAP_KEY=

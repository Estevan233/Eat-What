# FastAPI 后端配置
# 复制为 .env 并填入真实值（.env 不入版本控制）

# ---- 运行环境 ----
ENVIRONMENT=dev
DEBUG=true

# ---- 数据库 ----
# 开发期用 SQLite，单文件；生产切 PostgreSQL
DATABASE_URL=sqlite:///./dev.db

# ---- JWT ----
# 必填：随便一串长字符（≥32 位），可用 python3 -c "import secrets; print(secrets.token_urlsafe(48))" 生成
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=10080

# ---- 微信小程序 ----
# 必填：到 https://mp.weixin.qq.com 注册小程序后获取
WX_APPID=
WX_SECRET=

# ---- 和风天气 ----
# https://dev.qweather.com/ 注册开发者版 key（免费 1000 次/天）
HEFENG_KEY=
HEFENG_API=https://devapi.qweather.com/v7/weather/now
HEFENG_GEO_API=https://geoapi.qweather.com/v2/city/lookup

# ---- 高德地图（逆地理，可选）----
AMAP_KEY=

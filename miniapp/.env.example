# H5 本地开发使用；微信小程序默认改走 CloudBase callContainer
VITE_API_BASE_URL=http://localhost:8000

# CloudBase 环境 ID 与云托管服务名都不是密钥，可按环境覆盖
VITE_CLOUDBASE_ENV_ID=cloud1-d8gz4jm8vb964a1c9
VITE_CLOUDBASE_SERVICE=eat-what-api

# AI 用餐意图（默认关闭）。仅当模型预检通过后设为 true，关闭时首页不展示 AI 入口。
VITE_AI_MEAL_INTENT_ENABLED=false
# 二期小程序成长计划：hunyuan-v3 provider + hy3-preview 模型
VITE_AI_MEAL_INTENT_PROVIDER=hunyuan-v3
VITE_AI_MEAL_INTENT_MODEL=hy3-preview

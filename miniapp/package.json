    "@vue/tsconfig": "^0.1.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.23.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.2.5",
    "sass": "^1.101.7",
    "typescript": "^5.3.0",
